# ─────────────────────────────────────────────
# CivicAid Backend — Environment Variables
# Copy this file to .env and fill in your key
# ─────────────────────────────────────────────

# ── Groq API Key (FREE — no payment needed) ──
# 1. Go to console.groq.com
# 2. Sign up (free — no credit card)
# 3. Click "API Keys" → "Create API Key"
# 4. Paste it below
GROQ_API_KEY=your_groq_key_here

# ── App ───────────────────────────────────────
APP_ENV=development
APP_VERSION=2.0.0
APP_SECRET_KEY=change-this-in-production
REMINDER_SWEEP_TOKEN=change-this-to-a-long-random-token

# ── CORS ─────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Cache ────────────────────────────────────
# Falls back to in-memory dict if Redis is unavailable
REDIS_URL=redis://localhost:6379
# Development default. Use a managed PostgreSQL URL in production.
DATABASE_URL=sqlite:///./data/civicaid.db

# ── OCR ──────────────────────────────────────
# Linux / Render deployment
TESSERACT_PATH=/usr/bin/tesseract
# Windows local development (uncomment this line, comment the one above)
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

MAX_UPLOAD_MB=10

# ── RAG Pipeline ─────────────────────────────
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAISS_INDEX_PATH=app/data/knowledge_base/faiss_index
KNOWLEDGE_BASE_PATH=app/data/knowledge_base/tn_legal_kb.json
EVAL_SET_PATH=app/data/eval/benchmark_150q.json
RAG_TOP_K=5
RAG_CONFIDENCE_THRESHOLD=0.35
BM25_WEIGHT=0.3
DENSE_WEIGHT=0.7

# ── Rate Limits ───────────────────────────────
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=5/minute
RATE_LIMIT_STATUS=30/minute
RATE_LIMIT_WHATSAPP=30/minute

# ── WhatsApp (Twilio Sandbox — FREE for testing) ──
# 1. Sign up free at twilio.com (no card charged for sandbox)
# 2. Console → Messaging → Try it out → WhatsApp Sandbox
# 3. Copy your Account SID and Auth Token below
# 4. Set Sandbox webhook "When a message comes in" to:
#    https://your-backend-url/api/whatsapp/webhook  (method: POST)
# 5. From your phone, WhatsApp the sandbox number with the join code shown
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
